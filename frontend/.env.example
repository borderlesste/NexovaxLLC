NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Cloudflare Turnstile site key (public). Keeps the login captcha working even if the API is down
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
API_INTERNAL_URL=http://localhost:4000
# Visitor IP for rate limits (see README): header set by your edge, and the secret shared with the API
CLIENT_IP_HEADER=cf-connecting-ip
PROXY_SHARED_SECRET=
# Public origin of the API: uploads and private downloads go straight there (not through Vercel)
NEXT_PUBLIC_API_URL=https://api.nexovax.com
